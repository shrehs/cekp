  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(rate(cekp_queries_total[5m]))", "legendFormat": "queries/sec", "refId": "A" }],
      "title": "Request Volume",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(cekp_query_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }, { "expr": "histogram_quantile(0.50, sum by (le) (rate(cekp_query_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "B" }],
      "title": "Query Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" },
      "targets": [{ "expr": "sum(rate(cekp_query_outcomes_total{outcome=~\"error|no_evidence|access_denied\"}[5m])) / clamp_min(sum(rate(cekp_query_outcomes_total[5m])), 1e-9)", "legendFormat": "failure rate", "refId": "A" }],
      "title": "Error / Non-success Rate",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (strategy) (rate(cekp_retrieval_strategy_total[5m]))", "legendFormat": "{{strategy}}", "refId": "A" }],
      "title": "Retrieval Strategy Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (outcome) (rate(cekp_query_outcomes_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }],
      "title": "Query Outcomes",
      "type": "timeseries"
    }
  ],
